# =====================================================================
# Backend API Environment Variables (apps/api)
# =====================================================================

ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://internprep.ai,https://internprep-ai.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Providers
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Observability
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project
POSTHOG_PROJECT_API_KEY=your_posthog_key
POSTHOG_HOST=https://us.i.posthog.com

# Access Control
ADMIN_EMAILS=admin@interviewprep.ai,krishnagahlod@gmail.com
