# =====================================================================
# AI Interview Coach & Placement Preparation Platform - Environment Config
# =====================================================================
# IMPORTANT: Copy this file to .env (or apps/api/.env and apps/web/.env.local)
# NEVER commit real API keys or credentials to version control.
# =====================================================================

# --- Application Environment ---
ENVIRONMENT=development  # 'development' | 'production' | 'test'
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://internprep.ai,https://internprep-ai.vercel.app

# --- Supabase (Auth, Database & Storage) ---
# Supabase URL & public anonymous key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT Secret (Used for cryptographic HMAC-SHA256 signature verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- AI & Large Language Model Gateways (SERVER-SIDE ONLY) ---
# Google Gemini (Primary for deep resume analytics & embeddings)
GEMINI_API_KEY=your-google-gemini-api-key

# Groq (Ultra low-latency LLM for real-time conversational interviews)
GROQ_API_KEY=your-groq-api-key

# Cerebras (High-throughput conversational LLM fallback)
CEREBRAS_API_KEY=your-cerebras-api-key

# OpenRouter (Optional multi-model gateway)
OPENROUTER_API_KEY=your-openrouter-api-key

# Model Selection Defaults
CONVERSATION_MODEL=llama-3.3-70b-versatile
ANALYSIS_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# --- Payment Gateway: Razorpay (SERVER-SIDE ONLY) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Observability & Telemetry ---
# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project

# PostHog Product Analytics
POSTHOG_PROJECT_API_KEY=phc_your_posthog_project_key
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Administrative Access Control ---
ADMIN_EMAILS=admin@interviewprep.ai,krishnagahlod@gmail.com
