## Proposed Changes

### Phase 1: Supabase Schema

#### [NEW] `golden_resume_bullets` table

```sql
CREATE TABLE golden_resume_bullets (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  bullet_text TEXT NOT NULL,
  resume_source TEXT NOT NULL,          -- filename of the source resume
  company_placed TEXT,                  -- McKinsey, Bain, BCG, etc. (extracted from filename)
  section_type TEXT NOT NULL,           -- 'experience', 'project', 'por', 'scholastic', 'extracurricular'
  structural_skeleton TEXT NOT NULL,    -- e.g., "Action Verb + Context + Quantified Impact (% / INR / team size)"
  action_verb TEXT,                     -- the leading verb: "Spearheaded", "Engineered", etc.
  has_metrics BOOLEAN DEFAULT false,    -- whether the bullet contains quantified impact
  metric_type TEXT,                     -- 'percentage', 'currency', 'team_size', 'count', 'time', null
  quality_tier TEXT DEFAULT 'gold',     -- 'gold' for verified Day 1 resumes
  embedding VECTOR(768),               -- gemini-embedding-001 vector
  created_at TIMESTAMPTZ DEFAULT now()
);

-- Index for fast similarity search
CREATE INDEX ON golden_resume_bullets 
  USING ivfflat (embedding vector_cosine_ops) WITH (lists = 20);
```

#### [NEW] `match_golden_bullets` RPC function

```sql
CREATE OR REPLACE FUNCTION match_golden_bullets (
  query_embedding VECTOR(768),
  match_count INT DEFAULT 3,
  filter_section_type TEXT DEFAULT NULL
) RETURNS TABLE (
  id UUID,
  bullet_text TEXT,
  structural_skeleton TEXT,
  action_verb TEXT,
  section_type TEXT,
  company_placed TEXT,
  similarity FLOAT
)
LANGUAGE plpgsql AS $$
BEGIN
  RETURN QUERY
  SELECT
    g.id, g.bullet_text, g.structural_skeleton, g.action_verb,
    g.section_type, g.company_placed,
    1 - (g.embedding <=> query_embedding) AS similarity
  FROM golden_resume_bullets g
  WHERE (filter_section_type IS NULL OR g.section_type = filter_section_type)
  ORDER BY g.embedding <=> query_embedding
  LIMIT match_count;
END;
$$;
```

